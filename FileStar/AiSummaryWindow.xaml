<Window x:Class="FileStar.AiSummaryWindow" Foreground="{DynamicResource Th.Text}"
        Icon="FileStar.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileStar"
        Title="AI로 메모·태그 만들기" Width="820" Height="680" MinWidth="560" MinHeight="400"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="12" Background="{DynamicResource Th.Pane.Bg}"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <DockPanel Margin="14">
        <!-- Provider + start -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Th.Window.Bg}" BorderBrush="{DynamicResource Th.Pane.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="AI" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <!-- Filled from AiSettings.Choices(): the cloud services, then each of the user's servers -->
                    <ComboBox x:Name="ProviderBox" Width="260" DisplayMemberPath="Label" SelectionChanged="ProviderBox_SelectionChanged"/>
                    <TextBlock x:Name="ModelText" Foreground="{DynamicResource Th.Text.Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SettingsButton" Content="설정..." Padding="8,2" Margin="0,0,6,0" Click="Settings_Click"/>
                        <Button x:Name="StartButton" Content="시작" FontWeight="SemiBold" Padding="14,3" Click="Start_Click"/>
                        <Button x:Name="StopButton" Content="중지" Padding="10,3" Margin="6,0,0,0" IsEnabled="False" Click="Stop_Click"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock x:Name="PrivacyText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Apply -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ApplyButton" Content="체크한 항목 저장" FontWeight="SemiBold" Padding="12,4" IsEnabled="False" Click="Apply_Click"/>
                <Button x:Name="CloseButton" Content="닫기" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
            <TextBlock x:Name="SummaryStatus" Foreground="{DynamicResource Th.Text.Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="결과를 확인·수정한 뒤 저장하세요. 이미 메모가 있으면 지우지 않고 아래에 덧붙이고, 태그는 합칩니다."/>
        </DockPanel>

        <!-- One card per file -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="JobList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:AiJob}">
                        <Border Background="{DynamicResource Th.Window.Bg}" BorderBrush="{DynamicResource Th.Pane.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding Apply}" IsEnabled="{Binding HasResult}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              ToolTip="저장할 항목"/>
                                    <TextBlock x:Name="Status" DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{DynamicResource Th.Text.Faint}" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                </DockPanel>
                                <!-- Which folder it is in: files gathered from subfolders can share a name -->
                                <TextBlock Text="{Binding FolderPath}" Foreground="{DynamicResource Th.Text.Faint}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="24,1,0,0" ToolTip="{Binding FullPath}"/>
                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Th.Note.Icon}" TextWrapping="Wrap" Margin="24,4,0,0"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                                <StackPanel Margin="24,8,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="메모" Foreground="{DynamicResource Th.Note.Header}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="70" MaxHeight="220" VerticalScrollBarVisibility="Auto" Padding="4"/>
                                    <TextBlock Text="태그 (쉼표로 구분)" Foreground="{DynamicResource Th.Tag.Fg}" FontWeight="SemiBold" Margin="0,8,0,3"/>
                                    <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Th.Error}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
