<!-- Dark theme colors: same keys as Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="Th.Window.Bg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Th.Menu.Bg" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Th.Toolbar.Bg" Color="#262626"/>
    <SolidColorBrush x:Key="Th.Toolbar.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Th.TabStrip.Bg" Color="#232323"/>
    <SolidColorBrush x:Key="Th.Tab.Bg" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="Th.Tab.ActiveBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Th.Status.Bg" Color="#252525"/>
    <SolidColorBrush x:Key="Th.Pane.Bg" Color="#232323"/>
    <SolidColorBrush x:Key="Th.Preview.Bg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Th.Input.Bg" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Th.Popup.Bg" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="Th.Header.Bg" Color="#252526"/>
    <SolidColorBrush x:Key="Th.Control.Bg" Color="#333333"/>

    <!-- Lines and borders -->
    <SolidColorBrush x:Key="Th.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Th.Input.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Th.Separator" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Th.Splitter" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="Th.Pane.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Th.Memo.Border" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Th.Popup.Border" Color="#454545"/>
    <SolidColorBrush x:Key="Th.Header.Border" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Th.Control.Border" Color="#4A4A4A"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Th.Text" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="Th.Text.Secondary" Color="#B8B8B8"/>
    <SolidColorBrush x:Key="Th.Text.Muted" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="Th.Text.Faint" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="Th.Text.Placeholder" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="Th.Text.Disabled" Color="#5A5A5A"/>

    <!-- Interaction -->
    <SolidColorBrush x:Key="Th.Hover" Color="#2F3A47"/>
    <SolidColorBrush x:Key="Th.HoverLight" Color="#2A3138"/>
    <SolidColorBrush x:Key="Th.Pressed" Color="#3A4A5C"/>
    <SolidColorBrush x:Key="Th.Selected" Color="#34465C"/>
    <SolidColorBrush x:Key="Th.Selected.Border" Color="#4F6E92"/>
    <!-- Selection in stock control templates (tree rows, list boxes) that read Windows' own highlight colors -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#34465C"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2E3A48"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E4E4E4"/>
    <SolidColorBrush x:Key="Th.MenuHover" Color="#3A3F46"/>
    <SolidColorBrush x:Key="Th.Header.Hover" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="Th.Control.Hover" Color="#3E3E3E"/>
    <SolidColorBrush x:Key="Th.Control.Pressed" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Th.TabClose.Hover" Color="#6A2F2A"/>
    <SolidColorBrush x:Key="Th.Marquee.Fill" Color="#334C9AFF"/>
    <SolidColorBrush x:Key="Th.Marquee.Stroke" Color="#4C9AFF"/>

    <!-- Accents -->
    <SolidColorBrush x:Key="Th.Accent" Color="#6FA8E8"/>
    <SolidColorBrush x:Key="Th.Folder" Color="#E0B33A"/>
    <SolidColorBrush x:Key="Th.Favorite.On" Color="#E8B020"/>
    <SolidColorBrush x:Key="Th.Crumb.Bg" Color="#6B4740"/>
    <SolidColorBrush x:Key="Th.Crumb.Fg" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Th.TreeLine" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="Th.TreePath" Color="#E0675C"/>
    <SolidColorBrush x:Key="Th.TreeArrow" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="Th.TreeArrow.Hover" Color="#6FA8E8"/>
    <SolidColorBrush x:Key="Th.TreeBox" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Th.Tag.Bg" Color="#2C3A4D"/>
    <SolidColorBrush x:Key="Th.Tag.Border" Color="#3E5371"/>
    <SolidColorBrush x:Key="Th.Tag.Fg" Color="#9CC3F0"/>
    <SolidColorBrush x:Key="Th.Tag.Icon" Color="#6FA8E8"/>
    <SolidColorBrush x:Key="Th.Note.Fg" Color="#D9B26A"/>
    <SolidColorBrush x:Key="Th.Note.Header" Color="#E0A65C"/>
    <SolidColorBrush x:Key="Th.Note.Icon" Color="#D9A35C"/>
    <SolidColorBrush x:Key="Th.Ai.Icon" Color="#A98BEA"/>
    <SolidColorBrush x:Key="Th.Warn" Color="#E09A3C"/>
    <SolidColorBrush x:Key="Th.Ok" Color="#6CBF73"/>
    <SolidColorBrush x:Key="Th.Error" Color="#E57368"/>

    <!-- Scroll bars -->
    <SolidColorBrush x:Key="Th.Scroll.Track" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Th.Scroll.Thumb" Color="#555555"/>
    <SolidColorBrush x:Key="Th.Scroll.ThumbHover" Color="#777777"/>
</ResourceDictionary>
