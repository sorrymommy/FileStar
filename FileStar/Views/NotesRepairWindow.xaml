<Window x:Class="FileStar.Views.NotesRepairWindow" Foreground="{DynamicResource Th.Text}" Background="{DynamicResource Th.Window.Bg}"
        Icon="pack://application:,,,/FileStar;component/FileStar.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileStar.ViewModels"
        Title="메모 정리" Width="720" Height="520" MinWidth="480" MinHeight="320"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="12"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:NotesRepairHeader}">
            <TextBlock x:Name="Header" Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,4"
                       Foreground="{DynamicResource Th.Note.Header}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="Header" Property="Margin" Value="0,0,0,4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotesRepairRow}">
            <CheckBox IsChecked="{Binding IsChecked}" Margin="0,3,0,3">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Paths, Mode=OneWay}"/>
                    <Run FontStyle="Italic" Text="{Binding MemoLine, Mode=OneWay}"/>
                </TextBlock>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="{DynamicResource Th.Text.Muted}"
                   Text="메모는 파일 경로와 함께 저장됩니다. Windows 탐색기 등 다른 프로그램에서 파일을 옮기면 메모가 떨어지는데, 같은 드라이브 안에서 옮긴 경우에는 파일 고유 번호로 새 위치를 찾아 다시 연결할 수 있습니다. (이름이 같은 채 옮겨진 파일은 FileStar가 알아서 다시 연결합니다.)"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="선택한 항목 적용" Padding="12,4" Command="{Binding ApplyCommand}"/>
            <Button Content="닫기" Width="84" Padding="0,4" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
        <Border BorderThickness="1" Padding="8" BorderBrush="{DynamicResource Th.Border}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Entries}" Focusable="False"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
