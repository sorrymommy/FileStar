<Window x:Class="FileStar.Views.AiSummaryWindow" Foreground="{DynamicResource Th.Text}"
        Icon="pack://application:,,,/FileStar;component/FileStar.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileStar.ViewModels"
        xmlns:conv="clr-namespace:FileStar.Views.Converters"
        Title="{Binding Title}" Width="820" Height="680" MinWidth="560" MinHeight="400"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="12" Background="{DynamicResource Th.Pane.Bg}"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
    </Window.Resources>
    <DockPanel Margin="14">
        <!-- Provider + start -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Th.Window.Bg}" BorderBrush="{DynamicResource Th.Pane.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="AI" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <!-- The cloud services, then each of the user's servers -->
                    <ComboBox Width="260" DisplayMemberPath="Label" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}"
                              IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}"/>
                    <TextBlock Text="{Binding ModelText}" Foreground="{DynamicResource Th.Text.Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="설정..." Padding="8,2" Margin="0,0,6,0" Command="{Binding SettingsCommand}"/>
                        <Button Content="{Binding StartText}" FontWeight="SemiBold" Padding="14,3" Command="{Binding StartCommand}"/>
                        <Button Content="중지" Padding="10,3" Margin="6,0,0,0" Command="{Binding StopCommand}"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding PrivacyText}" TextWrapping="Wrap" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Th.Warn}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPrivate}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Th.Ok}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Height="4" Margin="0,8,0,0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue, Mode=OneWay}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>

        <!-- Apply -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="체크한 항목 저장" FontWeight="SemiBold" Padding="12,4" Command="{Binding ApplyCommand}"/>
                <!-- IsCancel only closes dialogs opened with ShowDialog; this window is modeless, so close it explicitly -->
                <Button Content="닫기" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
            <TextBlock Text="{Binding SummaryStatus}" Foreground="{DynamicResource Th.Text.Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- One card per file -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Jobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:AiJob}">
                        <Border Background="{DynamicResource Th.Window.Bg}" BorderBrush="{DynamicResource Th.Pane.Border}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding Apply}" IsEnabled="{Binding HasResult}" VerticalAlignment="Center" Margin="0,0,8,0"
                                              ToolTip="저장할 항목"/>
                                    <TextBlock x:Name="Status" DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{DynamicResource Th.Text.Faint}" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                </DockPanel>
                                <!-- Which folder it is in: files gathered from subfolders can share a name -->
                                <TextBlock Text="{Binding FolderPath}" Foreground="{DynamicResource Th.Text.Faint}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="24,1,0,0" ToolTip="{Binding FullPath}"/>
                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Th.Note.Icon}" TextWrapping="Wrap" Margin="24,4,0,0"
                                           Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"/>
                                <StackPanel Margin="24,8,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="메모" Foreground="{DynamicResource Th.Note.Header}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding Summary, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="70" MaxHeight="220" VerticalScrollBarVisibility="Auto" Padding="4"/>
                                    <TextBlock Text="태그 (쉼표로 구분)" Foreground="{DynamicResource Th.Tag.Fg}" FontWeight="SemiBold" Margin="0,8,0,3"/>
                                    <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" Padding="4,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource Th.Error}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
