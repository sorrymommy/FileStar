<Window x:Class="FileStar.Views.AiFolderChoiceWindow" Foreground="{DynamicResource Th.Text}" Background="{DynamicResource Th.Window.Bg}"
        Icon="pack://application:,,,/FileStar;component/FileStar.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI로 메모·태그 만들기 — 폴더" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="12"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <RadioButton Content="{Binding DirectLabel}" IsChecked="{Binding DirectOnly}" Margin="0,0,0,4"/>
        <RadioButton Content="{Binding AllLabel}" IsChecked="{Binding WithSubfolders}" IsEnabled="{Binding CanIncludeSubfolders}"/>
        <CheckBox Content="이미 메모가 있는 파일은 건너뛰기 (메모 뒤에 수정된 파일은 포함)" IsChecked="{Binding SkipNoted}" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding SummaryText}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Th.Text.Muted}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="목록 만들기" Width="96" Padding="0,4" IsDefault="True" Click="Ok_Click"/>
            <Button Content="취소" Width="84" Padding="0,4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
