<Window x:Class="FileStar.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FileStar.Views"
        xmlns:conv="clr-namespace:FileStar.Views.Converters"
        xmlns:vm="clr-namespace:FileStar.ViewModels"
        xmlns:platform="clr-namespace:FileStar.Platform"
        Title="{Binding Title}" Icon="pack://application:,,,/FileStar;component/FileStar.ico" Width="1400" Height="800"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="12"
        Background="{DynamicResource Th.Window.Bg}" Foreground="{DynamicResource Th.Text}"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseUp="Window_MouseUp"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:PixelsToGridLengthConverter x:Key="PixelsToGridLength"/>
        <conv:NotNullToVisibilityConverter x:Key="NotNullToVisibility"/>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource Th.Accent}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Th.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Th.Pressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Th.Text.Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CrumbButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Th.Crumb.Fg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Th.Text.Muted}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Th.TabClose.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab pin: like the close button, with a neutral (not red) hover -->
        <Style x:Key="TabPinButton" TargetType="Button" BasedOn="{StaticResource TabCloseButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Th.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toolbar row: icon + label buttons; toggles show their on state -->
        <Style x:Key="BarButtonBase" TargetType="ButtonBase">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Th.Text}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Th.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Th.Pressed}"/>
                            </Trigger>
                            <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Th.Selected}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Th.Selected.Border}"/>
                            </Trigger>
                            <!-- Not usable right now (e.g. 폴더 비교 without two lists): faded, no hand cursor.
                                 The glyphs set their own color, so fading the whole button is what greys them out. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource BarButtonBase}"/>
        <Style x:Key="BarToggle" TargetType="ToggleButton" BasedOn="{StaticResource BarButtonBase}"/>
        <Style x:Key="BarGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{DynamicResource Th.Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- 속성 tab: one template per kind of line; the name column follows Properties.LabelWidth -->
        <DataTemplate DataType="{x:Type vm:PropertySection}">
            <TextBlock x:Name="SectionTitle" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,12,0,4" Foreground="{DynamicResource Th.Note.Header}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                    <Setter TargetName="SectionTitle" Property="Margin" Value="0,0,0,4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PropertyRow}">
            <Grid Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding DataContext.Properties.LabelWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PixelsToGridLength}}"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,1,0,0" Background="Transparent" Foreground="{DynamicResource Th.Text.Muted}">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding HideHeader}" Command="{Binding HideCommand}" CommandParameter="{Binding Key}"/>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <TextBox Grid.Column="2" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" Padding="0"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FolderSizeRow}">
            <Grid Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding DataContext.Properties.LabelWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PixelsToGridLength}}"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Margin="0,1,0,0" Background="Transparent" Foreground="{DynamicResource Th.Text.Muted}">
                    <TextBlock.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{Binding HideHeader}" Command="{Binding HideCommand}" CommandParameter="{Binding Key}"/>
                        </ContextMenu>
                    </TextBlock.ContextMenu>
                </TextBlock>
                <Button x:Name="CalculateButton" Grid.Column="2" Content="{Binding ButtonText}" Command="{Binding CalculateCommand}"
                        Padding="8,1" HorizontalAlignment="Left"/>
                <TextBox x:Name="SizeValue" Grid.Column="2" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" TextWrapping="Wrap" Padding="0" Visibility="Collapsed"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Value, Converter={StaticResource NotNullToVisibility}}" Value="Visible">
                    <Setter TargetName="CalculateButton" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="SizeValue" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PropertyFlags}">
            <ItemsControl ItemsSource="{Binding Flags}" Margin="0,0,0,4" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox x:Name="Flag" Content="{Binding Label}" IsChecked="{Binding IsOn, Mode=OneWay}" IsHitTestVisible="False" Focusable="False"
                                  Margin="0,2,6,2" Foreground="{DynamicResource Th.Text.Faint}"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOn}" Value="True">
                                <Setter TargetName="Flag" Property="Foreground" Value="{DynamicResource Th.Text}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu + toolbar -->
        <StackPanel Grid.Row="0">
        <Menu Background="{DynamicResource Th.Menu.Bg}" Padding="2">
            <MenuItem Header="파일(_F)">
                <MenuItem Header="{Binding UndoHeader}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}"/>
                <Separator/>
                <MenuItem Header="새 창(_N)" InputGestureText="Ctrl+N" Command="{Binding NewWindowCommand}"/>
                <MenuItem Header="새 탭(_T)" InputGestureText="Ctrl+T" Command="{Binding NewTabCommand}"/>
                <MenuItem Header="새 폴더(_F)" InputGestureText="Ctrl+Shift+N" Command="{Binding NewFolderCommand}"/>
                <MenuItem Header="탭 닫기(_W)" InputGestureText="Ctrl+W" Command="{Binding CloseActiveTabCommand}"/>
                <Separator/>
                <MenuItem Header="현재 폴더를 Windows 탐색기에서 열기" Command="{Binding OpenCurrentInExplorerCommand}"/>
                <Separator/>
                <MenuItem Header="끝내기(_X)" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="숨김 파일 표시(_H)" IsCheckable="True" IsChecked="{Binding ShowHidden}" InputGestureText="Ctrl+H"/>
                <MenuItem Header="메모·태그 표시(_N)" IsCheckable="True" IsChecked="{Binding ShowNoteMarks}" InputGestureText="Ctrl+Shift+H"/>
                <MenuItem Header="두 창 보기(_D)" IsCheckable="True" IsChecked="{Binding IsDualVisible}" InputGestureText="Ctrl+Shift+D"/>
                <MenuItem Header="폴더 비교(_C)" IsCheckable="True" IsChecked="{Binding IsCompareOn}" InputGestureText="Ctrl+Shift+K"/>
                <MenuItem x:Name="ColumnsMenu" Header="표시할 열(_C)" SubmenuOpened="ColumnsMenu_SubmenuOpened">
                    <MenuItem Header="(열 목록)"/>
                </MenuItem>
                <MenuItem Header="전체 화면(_U)" InputGestureText="F11" Click="FullScreen_Click"/>
                <MenuItem Header="다크 모드(_K)" IsCheckable="True" IsChecked="{Binding IsDarkMode}"/>
                <MenuItem Header="정보 창 (메모·태그·속성)(_M)" IsCheckable="True" IsChecked="{Binding IsInfoPaneVisible}" InputGestureText="F9"/>
                <MenuItem Header="새로 고침(_R)" InputGestureText="F5" Command="{Binding RefreshCommand}"/>
            </MenuItem>
            <!-- Items with a Tag get the folder's own Windows icon at startup (SetGoMenuIcons) -->
            <MenuItem x:Name="GoMenu" Header="이동(_G)">
                <MenuItem Header="뒤로" InputGestureText="Alt+←" Command="{Binding GoBackCommand}"/>
                <MenuItem Header="앞으로" InputGestureText="Alt+→" Command="{Binding GoForwardCommand}"/>
                <MenuItem Header="상위 폴더" InputGestureText="Alt+↑" Command="{Binding GoUpCommand}"/>
                <Separator/>
                <!-- Filled when opened (RecentMenu_SubmenuOpened) -->
                <MenuItem x:Name="RecentFoldersMenu" Header="최근 폴더" SubmenuOpened="RecentMenu_SubmenuOpened">
                    <MenuItem Header="(없음)" IsEnabled="False"/>
                </MenuItem>
                <MenuItem x:Name="RecentFilesMenu" Header="최근 파일" SubmenuOpened="RecentMenu_SubmenuOpened">
                    <MenuItem Header="(없음)" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="내 PC" Tag="ThisPc" InputGestureText="Ctrl+Shift+P" Command="{Binding GoSpecialCommand}" CommandParameter="ThisPc"/>
                <MenuItem Header="바탕 화면" Tag="Desktop" Command="{Binding GoSpecialCommand}" CommandParameter="Desktop"/>
                <MenuItem Header="문서" Tag="Documents" Command="{Binding GoSpecialCommand}" CommandParameter="Documents"/>
                <MenuItem Header="다운로드" Tag="Downloads" Command="{Binding GoSpecialCommand}" CommandParameter="Downloads"/>
                <MenuItem Header="사용자 폴더" Tag="Home" Command="{Binding GoSpecialCommand}" CommandParameter="Home"/>
            </MenuItem>
            <!-- Items come from MainViewModel.FavoritesMenu -->
            <MenuItem x:Name="FavoritesMenu" Header="즐겨찾기(_A)"/>
            <MenuItem Header="도구(_T)">
                <MenuItem Header="AI로 메모·태그 만들기..." InputGestureText="Ctrl+Shift+M" Command="{Binding AiSummaryCommand}"/>
                <Separator/>
                <MenuItem Header="AI 설정..." Command="{Binding AiSettingsCommand}"/>
                <Separator/>
                <MenuItem Header="메모 정리..." Command="{Binding NotesRepairCommand}"
                          ToolTip="다른 프로그램에서 옮긴 파일의 메모를 다시 연결하고, 지워진 파일의 메모를 정리합니다"/>
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem Header="단축키 목록" InputGestureText="F1" Command="{Binding ShortcutHelpCommand}"/>
                <Separator/>
                <MenuItem Header="업데이트 확인..." Command="{Binding CheckForUpdatesCommand}"/>
                <MenuItem Header="FileStar 정보" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>
        <!-- Toolbar: one-click versions of menu commands (currently the 보기 menu) -->
        <Border Background="{DynamicResource Th.Toolbar.Bg}" BorderBrush="{DynamicResource Th.Toolbar.Border}" BorderThickness="0,1" Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ToggleHiddenCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                            <Setter Property="ToolTip" Value="숨김 파일 표시 (Ctrl+H)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowHidden}" Value="True">
                                    <Setter Property="ToolTip" Value="숨김 파일 숨기기 (Ctrl+H)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <!-- Slashed eye = hide them again, eye = show them -->
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BarGlyph}">
                                <Setter Property="Text" Value="&#xE890;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowHidden}" Value="True">
                                        <Setter Property="Text" Value="&#xED1A;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <!-- Memo/tag markers: a sticky note with light rays while they show, without while off (blue like the other tools) -->
                <Button Command="{Binding ToggleNoteMarksCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                            <Setter Property="ToolTip" Value="메모·태그 표시 끄기 (Ctrl+Shift+H)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNoteMarks}" Value="False">
                                    <Setter Property="ToolTip" Value="메모·태그 있는 파일 표시하기 (Ctrl+Shift+H)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Width="28" Height="28">
                        <TextBlock Style="{StaticResource BarGlyph}" FontSize="20" Text="&#xE70B;"
                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,1"
                                   Foreground="{DynamicResource Th.Accent}"/>
                        <Path Data="M20,8 L24.5,3.5 M22,12 L27.5,11.5 M16,6 L15.5,0.8"
                              Stroke="{DynamicResource Th.Accent}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Visibility="{Binding ShowNoteMarks, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Button>
                <Button x:Name="ColumnsButton" Style="{StaticResource BarButton}" ToolTip="파일 목록에 표시할 열 선택" Click="ColumnsButton_Click">
                    <TextBlock Style="{StaticResource BarGlyph}" Text="&#xE8FD;"/>
                </Button>
                <ToggleButton Style="{StaticResource BarToggle}" ToolTip="두 창 보기 (Ctrl+Shift+D)" IsChecked="{Binding IsDualVisible}">
                    <TextBlock Style="{StaticResource BarGlyph}" Text="&#xE89A;"/>
                </ToggleButton>
                <ToggleButton Style="{StaticResource BarToggle}" IsEnabled="{Binding IsDualVisible}" IsChecked="{Binding IsCompareOn}"
                              ToolTip="폴더 비교: 두 창의 폴더를 이름·크기·날짜로 비교 (Ctrl+Shift+K)">
                    <TextBlock Style="{StaticResource BarGlyph}" Text="&#xE7C4;"/>
                </ToggleButton>
                <ToggleButton Style="{StaticResource BarToggle}" ToolTip="정보 창 (메모·태그·속성·미리보기) 보기/숨기기 (F9)" IsChecked="{Binding IsInfoPaneVisible}">
                    <TextBlock Style="{StaticResource BarGlyph}" Text="&#xE8A0;"/>
                </ToggleButton>
                <!-- Icons show what a click does: expand ↔ shrink, moon (go dark) ↔ sun (go light) -->
                <Button x:Name="FullScreenButton" Style="{StaticResource BarButton}" ToolTip="전체 화면 (F11)" Click="FullScreen_Click">
                    <!-- Diagonal arrows inside a square frame -->
                    <Border Width="22" Height="22" BorderThickness="1.5" CornerRadius="1" BorderBrush="{DynamicResource Th.Accent}">
                        <TextBlock x:Name="FullScreenGlyph" Style="{StaticResource BarGlyph}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE92D;"/>
                    </Border>
                </Button>
                <Button Command="{Binding ToggleDarkModeCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource BarButton}">
                            <Setter Property="ToolTip" Value="다크 모드로 전환"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                    <Setter Property="ToolTip" Value="라이트 모드로 전환"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BarGlyph}">
                                <Setter Property="Text" Value="&#xE708;"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                        <Setter Property="Text" Value="&#xE706;"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Rectangle Width="1" Fill="{DynamicResource Th.Separator}" Margin="6,5"/>
                <Button Style="{StaticResource BarButton}" ToolTip="새로 고침 (F5)" Command="{Binding RefreshCommand}">
                    <TextBlock Style="{StaticResource BarGlyph}" Text="&#xE72C;"/>
                </Button>
            </StackPanel>
        </Border>
        </StackPanel>

        <!-- Toolbar + address bar + search -->
        <Grid Grid.Row="1" Margin="4,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolButton}" Content="&#xE72B;" ToolTip="뒤로 (Alt+←)" Command="{Binding GoBackCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="&#xE72A;" ToolTip="앞으로 (Alt+→)" Command="{Binding GoForwardCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="&#xE74A;" ToolTip="상위 폴더 (Alt+↑)" Command="{Binding GoUpCommand}"/>
                <Button Style="{StaticResource ToolButton}" Content="&#xE7F4;" ToolTip="내 PC (Ctrl+Shift+P)" Command="{Binding GoSpecialCommand}" CommandParameter="ThisPc"/>
                <Button Style="{StaticResource ToolButton}" Content="&#xE72C;" ToolTip="새로 고침 (F5)" Command="{Binding RefreshCommand}"/>
                <Button x:Name="FavoriteButton" IsEnabled="{Binding CanFavorite}" Click="FavoriteButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                            <Setter Property="Content" Value="&#xE734;"/>
                            <Setter Property="ToolTip" Value="즐겨찾기에 추가 (Ctrl+B)"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter Property="Content" Value="&#xE735;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Th.Favorite.On}"/>
                                    <Setter Property="ToolTip" Value="즐겨찾기에서 제거 (Ctrl+B)"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource ToolButton}" Content="&#xE8F4;" ToolTip="새 폴더 (Ctrl+Shift+N)" Command="{Binding NewFolderCommand}"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="6,0" BorderBrush="{DynamicResource Th.Input.Border}" Background="{DynamicResource Th.Input.Bg}" BorderThickness="1" CornerRadius="3" Height="28">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" Foreground="{DynamicResource Th.Folder}"
                               VerticalAlignment="Center" Margin="7,0,4,0" FontSize="14"/>
                    <TextBox x:Name="AddressBox" BorderThickness="0" VerticalContentAlignment="Center"
                             Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus"
                             PreviewMouseLeftButtonDown="AddressBox_PreviewMouseLeftButtonDown"/>
                </DockPanel>
            </Border>
            <!-- 검색: opens a search tab (its options and results live there, not in this bar) -->
            <Button Grid.Column="2" Height="28" Cursor="Hand" Command="{Binding OpenSearchCommand}"
                    ToolTip="파일 이름·확장자·태그·메모 검색 (Ctrl+F)">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" BorderBrush="{DynamicResource Th.Input.Border}" Background="{DynamicResource Th.Input.Bg}" BorderThickness="1" CornerRadius="3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,10,0">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Foreground="{DynamicResource Th.Accent}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="검색" Foreground="{DynamicResource Th.Text}" VerticalAlignment="Center"/>
                                <TextBlock Text="Ctrl+F" Foreground="{DynamicResource Th.Text.Faint}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Th.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Tabs -->
        <Border Grid.Row="2" Background="{DynamicResource Th.TabStrip.Bg}" BorderBrush="{DynamicResource Th.Border}" BorderThickness="0,1,0,0" Padding="4,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BrowserTab}">
                                <Border x:Name="TabBorder" Background="{DynamicResource Th.Tab.Bg}" CornerRadius="4,4,0,0" Margin="0,4,2,0" Padding="8,4,4,4"
                                        ToolTip="{Binding FullPath}" Cursor="Hand" MouseUp="Tab_MouseUp">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" CommandParameter="{Binding}"
                                                      Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Border.InputBindings>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="TabTitle" Text="{Binding Title}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <!-- 고정: a leaning pin on hover / the active tab; pinned, it stands upright, lit, and the close button goes -->
                                        <Button x:Name="TabPin" Style="{StaticResource TabPinButton}" FontSize="11" Visibility="Hidden"
                                                ToolTip="탭 고정 (닫히지 않게)" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.PinTabCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock x:Name="TabPinGlyph" Text="&#xE718;" RenderTransformOrigin="0.5,0.5"/>
                                        </Button>
                                        <Button x:Name="TabClose" Style="{StaticResource TabCloseButton}" Content="&#xE711;" Margin="2,0,0,0"
                                                ToolTip="탭 닫기 (Ctrl+W)" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Th.Tab.ActiveBg}"/>
                                        <Setter TargetName="TabTitle" Property="FontWeight" Value="SemiBold"/>
                                        <Setter TargetName="TabPin" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabPin" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter TargetName="TabPin" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="TabPinGlyph" Property="Text" Value="&#xE840;"/>
                                        <Setter TargetName="TabPinGlyph" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="-45"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="TabPin" Property="Foreground" Value="{DynamicResource Th.Accent}"/>
                                        <Setter TargetName="TabPin" Property="ToolTip" Value="고정 해제 (닫을 수 있게)"/>
                                        <Setter TargetName="TabClose" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolButton}" Content="&#xE710;" FontSize="11" Width="26" Height="24" Margin="2,4,0,0"
                            ToolTip="새 탭 (Ctrl+T)" Command="{Binding NewTabCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Breadcrumb -->
        <Border Grid.Row="3" Background="{DynamicResource Th.Crumb.Bg}" Padding="6,2">
            <ItemsControl ItemsSource="{Binding Crumbs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:Crumb}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="›" Foreground="{DynamicResource Th.Crumb.Fg}" FontSize="14" Margin="2,0" VerticalAlignment="Center"
                                       Visibility="{Binding ShowSeparator, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource CrumbButton}" Content="{Binding Name}" CommandParameter="{Binding FullPath}"
                                    Command="{Binding DataContext.CrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Tree | file list -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="320" MinWidth="120"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="ListColumn" Width="*" MinWidth="200"/>
                <!-- Second pane (보기 > 두 창 보기): zero width while hidden -->
                <ColumnDefinition x:Name="DualSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="DualColumn" Width="0"/>
                <ColumnDefinition x:Name="NoteSplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="NoteColumn" Width="340"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree" BorderThickness="0" Padding="2,4" ItemsSource="{Binding Tree.Roots}"
                      AllowDrop="True" DragEnter="Files_DragOver" DragOver="Files_DragOver" Drop="Files_Drop"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                      SelectedItemChanged="FolderTree_SelectedItemChanged"
                      ContextMenuOpening="FolderTree_ContextMenuOpening"
                      PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                      Loaded="FolderTree_Loaded" PreviewMouseWheel="FolderTree_PreviewMouseWheel">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <!-- Folder icon with a corner badge (so names never shift): a mini note when the folder has
                                 its own memo, a dot when it holds files that do. The ring in the window color keeps the
                                 badge readable on top of the icon. -->
                            <Grid Width="16" Height="16" Margin="0,0,5,0">
                                <Image Source="{Binding Icon}" Width="16" Height="16"/>
                                <Border x:Name="NodeMark" Width="10" Height="10" CornerRadius="5" Margin="0,0,-3,-3"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"
                                        Background="{DynamicResource Th.Window.Bg}">
                                    <TextBlock x:Name="NodeMarkGlyph" FontFamily="{StaticResource IconFont}" FontSize="8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Th.Note.Icon}"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="NodeName" Text="{Binding Name}" VerticalAlignment="Center"/>
                            <!-- F2: rename in place, like the file list -->
                            <TextBox x:Name="NodeRenameBox" Visibility="Collapsed" MinWidth="120" Padding="1,0" VerticalAlignment="Center"
                                     IsVisibleChanged="TreeRenameBox_IsVisibleChanged" PreviewKeyDown="TreeRenameBox_PreviewKeyDown"
                                     LostKeyboardFocus="TreeRenameBox_LostKeyboardFocus"/>
                        </StackPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding MarkKind}" Value="Memo">
                                <Setter TargetName="NodeMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NodeMark" Property="Background" Value="{DynamicResource Th.Note.Icon}"/>
                                <Setter TargetName="NodeMarkGlyph" Property="Text" Value="&#xE70B;"/>
                                <Setter TargetName="NodeMarkGlyph" Property="FontSize" Value="7"/>
                                <Setter TargetName="NodeMarkGlyph" Property="Foreground" Value="{DynamicResource Th.Window.Bg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MarkKind}" Value="InsideFolder">
                                <Setter TargetName="NodeMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NodeMarkGlyph" Property="Text" Value="&#xE915;"/>
                                <Setter TargetName="NodeMarkGlyph" Property="FontSize" Value="9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.ShowNoteMarks, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                <Setter TargetName="NodeMark" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                <Setter TargetName="NodeName" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="NodeRenameBox" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsVirtual}" Value="True">
                                <Setter TargetName="NodeName" Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="NodeName" Property="Foreground" Value="{DynamicResource Th.Text.Secondary}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFavoriteGroup}" Value="True">
                                <Setter TargetName="NodeName" Property="Foreground" Value="{DynamicResource Th.Note.Header}"/>
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource Th.Text}"/>
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        <Setter Property="Padding" Value="3,2"/>
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="TreeItem_PreviewMouseRightButtonDown"/>
                        <EventSetter Event="RequestBringIntoView" Handler="TreeItem_RequestBringIntoView"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <!--
                                    Column 0 (19px) holds the expander. A child's column 0 starts 19px to the right of its
                                    parent's, so the parent's vertical line (through the parent expander's center) sits at
                                    x = -10 in the child's coordinates; the child draws its own piece of it there.
                                -->
                                <ControlTemplate TargetType="TreeViewItem">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="19"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <!-- Connector from the parent's line to this item -->
                                        <Grid x:Name="Connector" Margin="-10,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Rectangle x:Name="LineTop" Width="1" HorizontalAlignment="Left" Fill="{DynamicResource Th.TreeLine}"/>
                                            <Rectangle x:Name="LineBottom" Grid.Row="1" Width="1" HorizontalAlignment="Left" Fill="{DynamicResource Th.TreeLine}"/>
                                            <Rectangle x:Name="LineHorizontal" Grid.Row="1" Height="1" Width="14" Margin="0,-1,0,0"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource Th.TreeLine}"/>
                                        </Grid>
                                        <!-- Parent's line continuing past this item's children to later siblings -->
                                        <Rectangle x:Name="LineChildren" Grid.Row="1" Width="1" Margin="-10,0,0,0"
                                                   HorizontalAlignment="Left" Fill="{DynamicResource Th.TreeLine}"/>

                                        <ToggleButton x:Name="Expander" ClickMode="Press" Focusable="False"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Box" Width="15" Height="15" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="2">
                                                        <Path x:Name="Arrow" Data="M 4,2 L 8,6 L 4,10" Stroke="{DynamicResource Th.TreeArrow}" StrokeThickness="1.3"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Arrow" Property="Data" Value="M 1,4 L 5,8 L 9,4"/>
                                                            <Setter TargetName="Arrow" Property="Margin" Value="0,1,0,0"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Th.TreeArrow.Hover}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsOnPath}" Value="True">
                                                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource Th.TreePath}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Th.TreePath}"/>
                                                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Th.TreeBox}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <Border x:Name="Bd" Grid.Column="1" Padding="{TemplateBinding Padding}" CornerRadius="3" Background="Transparent">
                                            <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
                                        </Border>
                                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="False">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                            <!-- No expander: run the connector all the way to the icon -->
                                            <Setter TargetName="LineHorizontal" Property="Width" Value="28"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter TargetName="LineBottom" Property="Visibility" Value="Hidden"/>
                                            <Setter TargetName="LineChildren" Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PathLineTop}" Value="True">
                                            <Setter TargetName="LineTop" Property="Fill" Value="{DynamicResource Th.TreePath}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PathLineBottom}" Value="True">
                                            <Setter TargetName="LineBottom" Property="Fill" Value="{DynamicResource Th.TreePath}"/>
                                            <Setter TargetName="LineChildren" Property="Fill" Value="{DynamicResource Th.TreePath}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsOnPath}" Value="True">
                                            <Setter TargetName="LineHorizontal" Property="Fill" Value="{DynamicResource Th.TreePath}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                            <Setter TargetName="Connector" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="LineChildren" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.Selected}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" SourceName="Bd" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Th.HoverLight}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ContextMenu>
                    <!-- Filled per node in FolderTree_ContextMenuOpening -->
                    <ContextMenu Opened="FolderTreeMenu_Opened" Closed="ContextMenu_Closed"/>
                </TreeView.ContextMenu>
            </TreeView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource Th.Splitter}"/>

            <!-- 두 창 보기: the left list's path bar, the same height as the right pane's, so both lists line up.
                 The line under it shows which pane has the keyboard. -->
            <Border x:Name="MainPaneHeader" Grid.Column="2" Height="{x:Static local:FolderPane.BarHeight}" VerticalAlignment="Top"
                    Visibility="{Binding IsDualVisible, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="{Binding MainPaneToolTip}" MouseLeftButtonDown="MainPaneHeader_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Th.Toolbar.Bg}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMainPaneHighlighted}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Th.Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel Margin="8,0">
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" Foreground="{DynamicResource Th.Folder}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding MainPaneTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <!-- 검색 탭: what to look for, what to look in and where; the results are the list under it -->
            <Border x:Name="SearchPanel" Grid.Column="2" VerticalAlignment="Top" Panel.ZIndex="1" DataContext="{Binding Search}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource Th.Pane.Bg}" BorderBrush="{DynamicResource Th.Border}" BorderThickness="0,0,0,1"
                    Padding="10,8,10,7" SizeChanged="SearchPanel_SizeChanged">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="검색" Padding="18,3" Margin="6,0,0,0" Command="{Binding RunCommand}"/>
                        <Border BorderBrush="{DynamicResource Th.Input.Border}" Background="{DynamicResource Th.Input.Bg}" BorderThickness="1" CornerRadius="3" Height="28">
                            <Grid>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Foreground="{DynamicResource Th.Accent}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13" IsHitTestVisible="False"/>
                                <TextBox x:Name="SearchQueryBox" BorderThickness="0" Background="Transparent" Margin="28,0,6,0"
                                         VerticalContentAlignment="Center" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="SearchQueryBox_KeyDown"/>
                                <TextBlock Text="검색어 · 여러 개는 ; 로 구분 (예: 보고서; *.pptx; #예산)" Foreground="{DynamicResource Th.Text.Placeholder}"
                                           Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchQueryBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DockPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="찾을 대상" Foreground="{DynamicResource Th.Text.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox Content="파일 이름" VerticalAlignment="Center" Margin="0,0,14,0" IsChecked="{Binding SearchName}" IsEnabled="{Binding FolderOptionsEnabled}"/>
                        <CheckBox Content="확장자" VerticalAlignment="Center" Margin="0,0,14,0" IsChecked="{Binding SearchExtension}" IsEnabled="{Binding FolderOptionsEnabled}"
                                  ToolTip="pdf, .pdf, *.pdf 모두 확장자 pdf로 찾습니다"/>
                        <CheckBox Content="태그" VerticalAlignment="Center" Margin="0,0,14,0" IsChecked="{Binding SearchTag}"/>
                        <CheckBox Content="메모" VerticalAlignment="Center" Margin="0,0,14,0" IsChecked="{Binding SearchMemo}"/>
                        <Rectangle Width="1" Height="16" Fill="{DynamicResource Th.Separator}" Margin="4,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Text="위치" Foreground="{DynamicResource Th.Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox MinWidth="180" MaxWidth="320" VerticalAlignment="Center" Margin="0,0,12,0" SelectedIndex="{Binding ScopeIndex}">
                            <ComboBoxItem Content="{Binding FolderLabel}" ToolTip="{Binding FolderPath}" IsEnabled="{Binding HasFolder}"/>
                            <ComboBoxItem Content="모든 위치 (메모·태그만)"/>
                        </ComboBox>
                        <CheckBox Content="하위 폴더 포함" VerticalAlignment="Center" IsChecked="{Binding Subfolders}" IsEnabled="{Binding FolderOptionsEnabled}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <ListView x:Name="FileList" Grid.Column="2" BorderThickness="0" ItemsSource="{Binding FileList.View}"
                      SelectionMode="Extended"
                      IsTextSearchEnabled="True" TextSearch.TextPath="Name"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard"
                      MouseDoubleClick="FileList_MouseDoubleClick"
                      KeyDown="FileList_KeyDown"
                      AllowDrop="True" DragEnter="Files_DragOver" DragOver="Files_DragOver" Drop="Files_Drop"
                      SelectionChanged="FileList_SelectionChanged"
                      ContextMenuOpening="FileList_ContextMenuOpening"
                      PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="FileList_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp"
                      LostMouseCapture="FileList_LostMouseCapture"
                      GridViewColumnHeader.Click="FileList_HeaderClick">
                <ListView.Resources>
                    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,2"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="44">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Content="#" Tag="Index"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="{DynamicResource Th.Text.Faint}" TextAlignment="Right"
                                               Text="{Binding RowNumber}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="460">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Name"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding NoteText}">
                                        <!-- Memo/tag marker before the icon (blank slot keeps names aligned); hidden by the toolbar toggle -->
                                        <TextBlock x:Name="Mark" FontFamily="{StaticResource IconFont}" FontSize="12" Width="14" Margin="0,0,4,0"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <!-- In-place rename (F2): replaces the name while IsRenaming -->
                                        <TextBox x:Name="RenameBox" Text="{Binding Name, Mode=OneTime}" Visibility="Collapsed" MinWidth="180"
                                                 Padding="1,0" Margin="-3,-2,0,-2" BorderBrush="{DynamicResource Th.Accent}"
                                                 IsVisibleChanged="RenameBox_IsVisibleChanged" PreviewKeyDown="RenameBox_PreviewKeyDown"
                                                 LostKeyboardFocus="RenameBox_LostKeyboardFocus"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding MarkKind}" Value="Memo">
                                            <Setter TargetName="Mark" Property="Text" Value="&#xE70B;"/>
                                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Th.Note.Icon}"/>
                                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MarkKind}" Value="Stale">
                                            <Setter TargetName="Mark" Property="Text" Value="&#xE70B;"/>
                                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Th.Error}"/>
                                            <Setter TargetName="Mark" Property="ToolTip" Value="메모를 쓴 뒤에 파일이 수정되었습니다 — 메모 갱신 필요"/>
                                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MarkKind}" Value="TagsOnly">
                                            <Setter TargetName="Mark" Property="Text" Value="&#xE8EC;"/>
                                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Th.Tag.Icon}"/>
                                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MarkKind}" Value="InsideFolder">
                                            <Setter TargetName="Mark" Property="Text" Value="&#xE915;"/>
                                            <Setter TargetName="Mark" Property="FontSize" Value="9"/>
                                            <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Th.Note.Icon}"/>
                                        </DataTrigger>
                                        <!-- 폴더 비교: identical on both sides, so it steps back -->
                                        <DataTrigger Binding="{Binding CompareState}" Value="Same">
                                            <Setter TargetName="NameText" Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                        <!-- Last, so it wins: markers off (search and tag results keep them) -->
                                        <DataTrigger Binding="{Binding DataContext.ListNoteMarks, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                            <Setter TargetName="Mark" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="NameText" Property="FontWeight" Value="Normal"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                            <Setter TargetName="NameText" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="RenameBox" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="260">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Note"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NoteSummary}" Foreground="{DynamicResource Th.Note.Fg}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding NoteText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="160">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Tags"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Th.Tag.Bg}" CornerRadius="7" Padding="5,0" Margin="0,0,3,0">
                                                    <TextBlock Text="{Binding StringFormat=#{0}}" Foreground="{DynamicResource Th.Tag.Fg}" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="70" DisplayMemberBinding="{Binding Extension}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Ext"/>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn Width="100">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Size"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="190" DisplayMemberBinding="{Binding TypeName}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Type"/>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <!-- 폴더 비교: this item against the other list (shown automatically while comparing) -->
                        <GridViewColumn Width="90">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Compare"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="CompareCell" Text="{Binding CompareText}" FontWeight="SemiBold"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CompareState}" Value="OnlyHere">
                                            <Setter TargetName="CompareCell" Property="Foreground" Value="{DynamicResource Th.Ok}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CompareState}" Value="Newer">
                                            <Setter TargetName="CompareCell" Property="Foreground" Value="{DynamicResource Th.Accent}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CompareState}" Value="Older">
                                            <Setter TargetName="CompareCell" Property="Foreground" Value="{DynamicResource Th.Text.Muted}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CompareState}" Value="Different">
                                            <Setter TargetName="CompareCell" Property="Foreground" Value="{DynamicResource Th.Warn}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CompareState}" Value="Same">
                                            <Setter TargetName="CompareCell" Property="Foreground" Value="{DynamicResource Th.Text.Faint}"/>
                                            <Setter TargetName="CompareCell" Property="FontWeight" Value="Normal"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- The folder each item is in: shown automatically for search and tag results -->
                        <GridViewColumn Width="320">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Folder"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FolderPath}" Foreground="{DynamicResource Th.Text.Muted}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FolderPath}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="160" DisplayMemberBinding="{Binding ModifiedText}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Modified"/>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn Width="160" DisplayMemberBinding="{Binding CreatedText}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Created"/>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn Width="160" DisplayMemberBinding="{Binding AccessedText}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Accessed"/>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridViewColumn Width="60" DisplayMemberBinding="{Binding AttributesText}">
                            <GridViewColumn.Header>
                                <GridViewColumnHeader Tag="Attributes" ToolTip="R 읽기 전용 · H 숨김 · S 시스템 · A 보관 · C 압축 · E 암호화"/>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                        <GridView.ColumnHeaderContextMenu>
                            <!-- Filled with one checkable item per column in ColumnMenu_Opened -->
                            <ContextMenu Opened="ColumnMenu_Opened"/>
                        </GridView.ColumnHeaderContextMenu>
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu Opened="FileListMenu_Opened" Closed="ContextMenu_Closed">
                        <MenuItem Header="열기" FontWeight="SemiBold" Command="{Binding OpenCommand}"/>
                        <MenuItem Header="새 탭에서 열기" Command="{Binding OpenInNewTabCommand}"/>
                        <!-- Search and tag results only: go to the folder the item is in, with it selected -->
                        <MenuItem Header="파일 위치 열기" Command="{Binding OpenLocationCommand}"
                                  Visibility="{Binding CanOpenLocation, Converter={StaticResource BoolToVisibility}}"/>
                        <MenuItem Header="{Binding ShowInExplorerHeader}" Command="{Binding ShowInExplorerCommand}"/>
                        <Separator/>
                        <MenuItem Header="잘라내기" InputGestureText="Ctrl+X" Command="{Binding CutCommand}"/>
                        <MenuItem Header="복사" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}"/>
                        <MenuItem Header="붙여넣기" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}"/>
                        <!-- Only while the second pane is open -->
                        <MenuItem Header="{Binding CopyToDualHeader}" Command="{Binding CopyToDualCommand}"
                                  Visibility="{Binding DualMenuVisible, Converter={StaticResource BoolToVisibility}}"/>
                        <MenuItem Header="{Binding MoveToDualHeader}" Command="{Binding MoveToDualCommand}"
                                  Visibility="{Binding DualMenuVisible, Converter={StaticResource BoolToVisibility}}"/>
                        <MenuItem Header="삭제" InputGestureText="Del" Command="{Binding DeleteCommand}"
                                  ToolTip="휴지통으로 보냅니다 (Shift를 누른 채 선택하면 영구 삭제)"/>
                        <MenuItem Header="이름 바꾸기" InputGestureText="F2" Command="{Binding RenameCommand}"/>
                        <MenuItem Header="이름 한꺼번에 바꾸기..." Command="{Binding BatchRenameCommand}"/>
                        <MenuItem Header="압축 (zip)" Command="{Binding ZipCommand}"/>
                        <MenuItem Header="압축 풀기" Command="{Binding UnzipCommand}"
                                  Visibility="{Binding CanUnzip, Converter={StaticResource BoolToVisibility}}"/>
                        <MenuItem Header="{Binding CopyPathHeader}" InputGestureText="Ctrl+Shift+C" Command="{Binding CopyPathCommand}"/>
                        <Separator/>
                        <!-- Add/remove favorite, with a group submenu once groups exist (filled when the menu opens) -->
                        <MenuItem x:Name="FileFavoriteMenuItem" Header="즐겨찾기에 추가"/>
                        <MenuItem Header="메모 작성/편집" InputGestureText="Ctrl+M" Command="{Binding EditNoteCommand}"/>
                        <MenuItem Header="AI로 메모·태그 만들기..." InputGestureText="Ctrl+Shift+M" Command="{Binding AiSummaryCommand}"/>
                        <Separator/>
                        <MenuItem Header="새 폴더" InputGestureText="Ctrl+Shift+N" Command="{Binding NewFolderCommand}"/>
                        <MenuItem Header="새로 고침" InputGestureText="F5" Command="{Binding RefreshCommand}"/>
                        <MenuItem Header="속성" InputGestureText="Alt+Enter" Command="{Binding PropertiesCommand}"/>
                        <Separator/>
                        <MenuItem x:Name="WindowsMenuItem" Header="탐색기 메뉴" InputGestureText="▸"
                                  ToolTip="Windows 탐색기의 오른쪽 클릭 메뉴 (Shift+오른쪽 클릭으로 바로 열기)"
                                  Click="WindowsMenuItem_Click" MouseEnter="WindowsMenuItem_MouseEnter" MouseLeave="WindowsMenuItem_MouseLeave">
                            <MenuItem.Icon>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE782;" Foreground="{DynamicResource Th.Accent}" FontSize="13"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <TextBlock x:Name="EmptyText" Grid.Column="2" Text="{Binding FileList.EmptyText}" Foreground="{DynamicResource Th.Text.Faint}"
                       HorizontalAlignment="Center" Margin="0,60,0,0" IsHitTestVisible="False"
                       Visibility="{Binding FileList.IsEmpty, Converter={StaticResource BoolToVisibility}}"/>
            <!-- Drag-rectangle selection box, drawn over the file list -->
            <Canvas x:Name="MarqueeCanvas" Grid.Column="2" IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle x:Name="MarqueeRect" Visibility="Collapsed" Fill="{DynamicResource Th.Marquee.Fill}" Stroke="{DynamicResource Th.Marquee.Stroke}" StrokeThickness="1"/>
            </Canvas>

            <!-- Second pane: another folder beside the first, for copying and moving between them -->
            <GridSplitter x:Name="DualSplitter" Grid.Column="3" HorizontalAlignment="Stretch" Background="{DynamicResource Th.Splitter}"
                          Visibility="{Binding IsDualVisible, Converter={StaticResource BoolToVisibility}}"/>
            <local:FolderPane x:Name="DualPane" Grid.Column="4" DataContext="{Binding Dual}"
                              Visibility="{Binding DataContext.IsDualVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>

            <!-- 폴더 비교: one bar over both lists (they move down by its height while it shows) -->
            <Border x:Name="CompareBar" Grid.Column="2" Grid.ColumnSpan="3" Height="34" VerticalAlignment="Top" DataContext="{Binding Compare}"
                    Visibility="{Binding IsOn, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource Th.Pane.Bg}" BorderBrush="{DynamicResource Th.Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="8,0,4,0">
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE7C4;" Foreground="{DynamicResource Th.Accent}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="&#xE711;" Width="28" Height="26"
                            ToolTip="비교 끄기" Command="{Binding DataContext.CompareOffCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button DockPanel.Dock="Right" Content="← 왼쪽으로 복사" Padding="8,2" Margin="6,0,6,0" VerticalAlignment="Center"
                            ToolTip="{Binding CopyLeftToolTip}" Command="{Binding DataContext.CopyLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <Button DockPanel.Dock="Right" Content="오른쪽으로 복사 →" Padding="8,2" VerticalAlignment="Center"
                            ToolTip="{Binding CopyRightToolTip}" Command="{Binding DataContext.CopyRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <CheckBox DockPanel.Dock="Right" Content="다른 것만 보기" VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding DiffOnly}"/>
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="이름이 같은 항목을 크기와 수정한 날짜로 비교합니다 (내용은 비교하지 않음). 폴더는 양쪽에 있으면 같음으로 봅니다."/>
                </DockPanel>
            </Border>

            <!-- Memo pane: notes about the selected file (or the current folder when nothing is selected) -->
            <GridSplitter x:Name="NoteSplitter" Grid.Column="5" HorizontalAlignment="Stretch" Background="{DynamicResource Th.Splitter}"/>
            <!--
                Info pane: one tab per panel at the very top, so each panel can later be shown or hidden on its own.
                Every tab starts with the same item header (MainViewModel.InfoHeader).
            -->
            <Border x:Name="NotePane" Grid.Column="6" Background="{DynamicResource Th.Pane.Bg}">
                <TabControl x:Name="InfoTabs" Background="Transparent" Margin="6,6,6,6" Padding="0" BorderBrush="{DynamicResource Th.Pane.Border}"
                            SelectedIndex="{Binding InfoTabIndex}" SelectionChanged="InfoTabs_SelectionChanged">
                    <TabItem x:Name="MemoTab" Header="메모 · 태그" Padding="12,4">
                    <DockPanel Margin="8,10,8,4" DataContext="{Binding Notes}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Image Source="{Binding DataContext.InfoHeader.Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="20" Height="20" Margin="0,1,8,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock x:Name="NoteTitle" Text="{Binding DataContext.InfoHeader.Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                            <TextBlock x:Name="NoteSubtitle" Text="{Binding DataContext.InfoHeader.Subtitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="{DynamicResource Th.Text.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8EC;" Foreground="{DynamicResource Th.Tag.Icon}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="태그" FontWeight="SemiBold" Foreground="{DynamicResource Th.Tag.Fg}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Th.Tag.Bg}" BorderBrush="{DynamicResource Th.Tag.Border}" BorderThickness="1" CornerRadius="10" Padding="8,1,3,1" Margin="0,0,5,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StringFormat=#{0}}" Foreground="{DynamicResource Th.Tag.Fg}" VerticalAlignment="Center" Cursor="Hand"
                                                       ToolTip="이 태그가 붙은 모든 파일 보기" MouseLeftButtonUp="TagChip_MouseLeftButtonUp"/>
                                            <Button Style="{StaticResource TabCloseButton}" Content="&#xE711;" Margin="3,0,0,0" Width="16" Height="16"
                                                    ToolTip="태그 제거" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Notes.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ComboBox x:Name="TagInput" IsEditable="True" IsTextSearchEnabled="False" Padding="4,3" IsEnabled="{Binding CanEdit}"
                                  Text="{Binding TagInput, UpdateSourceTrigger=PropertyChanged}"
                                  PreviewKeyDown="TagInput_PreviewKeyDown" DropDownOpened="TagInput_DropDownOpened"
                                  DropDownClosed="TagInput_DropDownClosed"/>
                        <TextBlock Foreground="{DynamicResource Th.Text.Faint}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Text="입력 후 Enter (쉼표로 여러 개) · ▼ 목록에서 기존 태그 선택"/>
                        <DockPanel Margin="0,14,0,5">
                            <!-- The memo is read-only until 수정; 저장/취소 replace 수정 while editing -->
                            <Button DockPanel.Dock="Right" Content="취소" Padding="10,1" Margin="6,0,0,0" Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" ToolTip="수정한 내용을 버립니다 (Esc)"/>
                            <Button DockPanel.Dock="Right" Padding="8,1" Margin="6,0,0,0" Command="{Binding SaveCommand}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" ToolTip="메모를 저장합니다 (Ctrl+S)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" Foreground="{DynamicResource Th.Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="저장" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Padding="8,1" Margin="6,0,0,0" Command="{Binding EditCommand}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}"
                                    ToolTip="메모를 수정합니다 (Ctrl+M · 메모 칸 더블클릭)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" Foreground="{DynamicResource Th.Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="수정"/>
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Padding="8,1" Command="{Binding DataContext.AiSummaryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ToolTip="선택한 파일의 내용을 AI가 읽고 메모·태그를 제안합니다 (Ctrl+Shift+M)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" Foreground="{DynamicResource Th.Ai.Icon}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="AI 요약"/>
                                </StackPanel>
                            </Button>
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70B;" Foreground="{DynamicResource Th.Note.Icon}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="메모" FontWeight="SemiBold" Foreground="{DynamicResource Th.Note.Header}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <!-- Shown when the file changed after the memo was written (FileNote.IsStaleFor) -->
                        <Border BorderBrush="{DynamicResource Th.Error}" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,0,6"
                                Visibility="{Binding IsStale, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="확인함" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        ToolTip="메모가 바뀐 파일에도 맞습니다 — 갱신 필요 표시를 지웁니다" Command="{Binding ConfirmCommand}"/>
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7BA;" Foreground="{DynamicResource Th.Error}"
                                           VerticalAlignment="Top" Margin="0,2,6,0"/>
                                <TextBlock Text="{Binding StaleText}" TextWrapping="Wrap" Foreground="{DynamicResource Th.Error}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="메모·태그 삭제" Padding="8,2" Command="{Binding DeleteCommand}"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Th.Text.Faint}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Foreground="{DynamicResource Th.Text.Faint}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="'수정'을 눌러 고치고 '저장'을 눌러야 저장됩니다(Ctrl+S 저장 · Esc 취소). 첫 줄은 목록의 '메모' 열에 표시됩니다. 검색(Ctrl+F)에서 메모와 태그로 파일을 찾을 수 있습니다."/>
                    <Grid>
                        <TextBox x:Name="NoteBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="5,6" FontSize="13"
                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBool}}" IsEnabled="{Binding CanEdit}"
                                 MouseDoubleClick="NoteBox_MouseDoubleClick">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Th.Memo.Border}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Th.Accent}"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Margin="10,8" Foreground="{DynamicResource Th.Text.Placeholder}" IsHitTestVisible="False" TextWrapping="Wrap"
                                   Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}"
                                   Text="메모가 없습니다. '수정'을 눌러 이 파일 안에 무엇이 들어 있는지 적어 두세요.&#10;&#10;예) 3분기 매출 보고서 최종본 (팀장 검토 완료)&#10;- 2쪽: 지역별 매출 요약&#10;- 5쪽: 4분기 목표와 일정"/>
                    </Grid>
                    </DockPanel>
                    </TabItem>
                    <TabItem x:Name="PropsTab" Header="속성" Padding="12,4">
                        <DockPanel Margin="8,10,8,4">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button x:Name="PropsChooserButton" DockPanel.Dock="Right" VerticalAlignment="Top" Padding="6,2"
                                        ToolTip="표시할 속성 고르기 (속성 이름을 오른쪽 클릭해 바로 숨길 수도 있습니다)" Click="PropsChooser_Click">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" Foreground="{DynamicResource Th.Accent}"/>
                                </Button>
                                <Image Source="{Binding InfoHeader.Icon}" Width="20" Height="20" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock x:Name="PropsTitle" Text="{Binding InfoHeader.Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding InfoHeader.Subtitle}" Foreground="{DynamicResource Th.Text.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- "속성 | 값" with a splitter between them: dragging it sets the name column for every row -->
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition MinWidth="50" MaxWidth="400"
                                                      Width="{Binding Properties.LabelWidth, Mode=TwoWay, Converter={StaticResource PixelsToGridLength}}"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="속성" FontSize="11" Foreground="{DynamicResource Th.Text.Faint}"/>
                                <TextBlock Grid.Column="2" Text="값" FontSize="11" Margin="2,0,0,0" Foreground="{DynamicResource Th.Text.Faint}"/>
                                <!-- A visible grip line in the middle of the transparent drag area -->
                                <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" IsHitTestVisible="False" Background="{DynamicResource Th.Border}"/>
                                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                              Background="Transparent" ToolTip="끌어서 속성 이름 칸의 폭을 바꿉니다" DragCompleted="PropsSplitter_DragCompleted"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Properties.Entries}" Focusable="False"/>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="PreviewTab" Header="미리보기" Padding="12,4">
                        <DockPanel Margin="8,10,8,4">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Image Source="{Binding InfoHeader.Icon}" Width="20" Height="20" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding InfoHeader.Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding InfoHeader.Subtitle}" Foreground="{DynamicResource Th.Text.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock x:Name="PreviewInfo" DockPanel.Dock="Bottom" Foreground="{DynamicResource Th.Text.Faint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <!-- Exactly one of these is visible at a time (see ShowPreviewView) -->
                            <Border BorderBrush="{DynamicResource Th.Pane.Border}" BorderThickness="1" Background="{DynamicResource Th.Preview.Bg}">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="6"
                                           RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                                    <TextBox x:Name="PreviewText" IsReadOnly="True" BorderThickness="0" Padding="6"
                                             FontFamily="D2Coding, Consolas, Malgun Gothic" FontSize="12"
                                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
                                    <platform:PreviewHost x:Name="PreviewHandlerHost" Visibility="Collapsed"/>
                                    <!-- Hancom documents: embedded first-page image above, body text below -->
                                    <Grid x:Name="PreviewDocView" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="3*"/>
                                            <RowDefinition Height="5"/>
                                            <RowDefinition Height="2*"/>
                                        </Grid.RowDefinitions>
                                        <Image x:Name="PreviewDocImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="6"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{DynamicResource Th.Splitter}"/>
                                        <TextBox x:Name="PreviewDocText" Grid.Row="2" IsReadOnly="True" BorderThickness="0" Padding="6"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12"/>
                                    </Grid>
                                    <StackPanel x:Name="PreviewMessagePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                        <TextBlock x:Name="PreviewMessage" Foreground="{DynamicResource Th.Text.Faint}" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Button x:Name="PreviewLoadButton" Content="다운로드하여 미리보기" Padding="10,3" Margin="0,10,0,0"
                                                HorizontalAlignment="Center" Visibility="Collapsed" Click="PreviewLoad_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="5" Background="{DynamicResource Th.Status.Bg}" BorderBrush="{DynamicResource Th.Border}" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock Text="{Binding Status.DriveText}" Foreground="{DynamicResource Th.Text.Secondary}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="{Binding Status.Text}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
