<Window x:Class="FileStar.Views.AiSettingsWindow" Foreground="{DynamicResource Th.Text}" Background="{DynamicResource Th.Window.Bg}"
        Icon="pack://application:,,,/FileStar;component/FileStar.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileStar.ViewModels"
        Title="AI 설정" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="12"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- The service's usual hint, replaced by the outcome once its model list was loaded -->
        <Style x:Key="StatusOrHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Th.Text.Faint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <!-- Default AI: cloud services first, then the user's servers -->
        <DockPanel>
            <TextBlock Text="기본 AI" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox DisplayMemberPath="Label" ItemsSource="{Binding DefaultChoices}" SelectedItem="{Binding SelectedDefault}"/>
        </DockPanel>
        <TextBlock Text="{Binding DefaultHint}" Foreground="{DynamicResource Th.Text.Faint}" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <TabControl Margin="0,12,0,0" Height="300" SelectedIndex="{Binding TabIndex}">
            <TabItem Header="Claude">
                <Grid Margin="12" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource Th.Text}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="모델" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" IsEditable="True" Margin="0,0,0,6" ItemsSource="{x:Static vm:AiSettingsViewModel.ClaudeModels}"
                              Text="{Binding ClaudeModel, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="API 키" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1" Padding="2,3" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{DynamicResource Th.Text.Faint}" TextWrapping="Wrap"
                               Text="Anthropic. 요약 품질이 가장 좋고 PDF·이미지도 읽습니다. 문서 내용이 Anthropic 서버로 전송됩니다.&#10;키를 비워 두면 ANTHROPIC_API_KEY 환경 변수 또는 'ant auth login' 로그인 정보를 사용합니다.&#10;opus = 최고 품질, sonnet = 균형, haiku = 가장 저렴·빠름."/>
                </Grid>
            </TabItem>

            <TabItem Header="ChatGPT">
                <Grid Margin="12" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource Th.Text}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="모델" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" IsEditable="True" Margin="0,0,0,6" ItemsSource="{Binding OpenAiModels}"
                              Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="모델 목록" Padding="8,2" Margin="6,0,0,6" Command="{Binding LoadOpenAiModelsCommand}"/>
                    <TextBlock Grid.Row="1" Text="API 키" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="OpenAiKeyBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="2,3" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusOrHint}">
                                <Setter Property="Text" Value="{Binding OpenAiStatus}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding OpenAiStatus}" Value="">
                                        <Setter Property="Text" Value="OpenAI. PDF·이미지도 읽습니다. 문서 내용이 OpenAI 서버로 전송됩니다.&#10;platform.openai.com에서 만든 API 키를 넣으세요(ChatGPT 구독과 별도로 사용량만큼 과금). 비워 두면 OPENAI_API_KEY 환경 변수를 사용합니다.&#10;'모델 목록'은 이 키로 쓸 수 있는 모델을 불러옵니다."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="Gemini">
                <Grid Margin="12" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource Th.Text}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="모델" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" IsEditable="True" Margin="0,0,0,6" ItemsSource="{Binding GeminiModels}"
                              Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="2" Content="모델 목록" Padding="8,2" Margin="6,0,0,6" Command="{Binding LoadGeminiModelsCommand}"/>
                    <TextBlock Grid.Row="1" Text="API 키" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="GeminiKeyBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="2,3" Margin="0,0,0,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusOrHint}">
                                <Setter Property="Text" Value="{Binding GeminiStatus}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GeminiStatus}" Value="">
                                        <Setter Property="Text" Value="Google. PDF·이미지도 읽습니다. 문서 내용이 Google 서버로 전송됩니다.&#10;aistudio.google.com에서 만든 API 키를 넣으세요. 비워 두면 GEMINI_API_KEY(또는 GOOGLE_API_KEY) 환경 변수를 사용합니다.&#10;무료 등급 키는 Google이 입력 내용을 학습에 쓸 수 있으니 주의하세요."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="직접 추가한 서버">
                <Grid Margin="12" TextElement.FontWeight="Normal" TextElement.Foreground="{DynamicResource Th.Text}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,10,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="추가" Width="70" Padding="0,2" Command="{Binding AddServerCommand}"/>
                            <Button Content="삭제" Width="70" Padding="0,2" Margin="6,0,0,0" Command="{Binding RemoveServerCommand}"/>
                        </StackPanel>
                        <ListBox DisplayMemberPath="Name" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}"/>
                    </DockPanel>
                    <TextBlock Grid.Column="1" Foreground="{DynamicResource Th.Text.Faint}" TextWrapping="Wrap"
                               Text="'추가'를 눌러 Ollama나 OpenAI 호환 서버를 등록하세요. 여러 개 등록할 수 있습니다.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedServer}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid Grid.Column="1" DataContext="{Binding SelectedServer}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="이름" VerticalAlignment="Center"/>
                        <TextBox x:Name="ServerNameBox" Grid.Column="1" Grid.ColumnSpan="2" Padding="2,3" Margin="0,0,0,6"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Text="종류" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6" SelectedIndex="{Binding KindIndex}">
                            <ComboBoxItem Content="Ollama"/>
                            <ComboBoxItem Content="OpenAI 호환 (LM Studio · vLLM · 사내 게이트웨이 등)"/>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Text="주소" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Padding="2,3" Margin="0,0,0,6"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="3" Text="API 키" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="ServerKeyBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Padding="2,3" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="4" Text="모델" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" IsEditable="True" Margin="0,0,0,6" ItemsSource="{Binding ModelChoices}"
                                  Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Row="4" Grid.Column="2" Content="모델 목록" Padding="8,2" Margin="6,0,0,6"
                                Command="{Binding DataContext.LoadServerModelsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Status}" Foreground="{DynamicResource Th.Text.Faint}" TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="저장" Width="84" Padding="0,4" IsDefault="True" Click="Save_Click"/>
            <Button Content="취소" Width="84" Padding="0,4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
