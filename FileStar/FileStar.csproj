<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FileStar</AssemblyName>
    <RootNamespace>FileStar</RootNamespace>
    <Product>FileStar</Product>
    <AssemblyTitle>FileStar</AssemblyTitle>
    <ApplicationIcon>FileStar.ico</ApplicationIcon>
    <!-- Shown in 설정 > 앱 and used for the installer's file name (installer/build-installer.ps1) -->
    <Version>1.0.0</Version>
    <Company>FileStar</Company>
    <Copyright>Copyright © 2026</Copyright>
    <!-- Main is in App.xaml.cs so Velopack can run before WPF starts (install/update hooks) -->
    <StartupObject>FileStar.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window title-bar/taskbar icon (Icon="FileStar.ico" in the XAML windows) -->
    <Resource Include="FileStar.ico" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
